{
  "name": "commit-master",
  "version": "0.0.6",
  "description": "A command-line toolkit offering a collection of utilities for automatic file commits and commits with custom backdated timestamps.",
  "type": "module",
  "bin": {
    "commitspan": "dist/CommitMasterCommitspan.js",
    "autocommit": "dist/CommitMasterAutocommit.js"
  },
  "main": "dist/CommitMasterCli.js",
  "types": "dist/CommitMasterCli.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && tsc -p tsconfig.test.json && node --test test-dist/CommitMasterCli.test.js"
  },
  "engines": {
    "node": ">=18.18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/safdar-azeem/commit-master.git"
  },
  "bugs": {
    "url": "https://github.com/safdar-azeem/commit-master/issues"
  },
  "homepage": "https://github.com/safdar-azeem/commit-master#readme",
  "author": "Safdar Azeem (https://github.com/safdar-azeem)",
  "license": "MIT",
  "keywords": [
    "git",
    "cli",
    "commit",
    "autocommit",
    "commitspan",
    "history",
    "automation",
    "developer-tools",
    "Auto Commit Message",
    "git",
    "scm",
    "version control",
    "source control",
    "git commit",
    "commit message",
    "automate",
    "bulk commit",
    "batch commit",
    "productivity",
    "developer tools"
  ],
  "devDependencies": {
    "@types/node": "^20.17.0",
    "typescript": "^5.7.0"
  },
  "prettier": {
    "printWidth": 100,
    "semi": false,
    "singleQuote": true,
    "trailingComma": "es5",
    "tabWidth": 3,
    "endOfLine": "auto",
    "bracketSameLine": true
  }
}